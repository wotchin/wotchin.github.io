extends base

block title
  if page.category
    title= page.category + ' | ' + config.title
  if page.tag
    title= page.tag + ' | ' + config.title
  if page.archive
    title= __('archive') + ' | ' + config.title
block content
  -
    function languageOf(item) {
      if (!item) return 'en';
      var declared = String(item.lang || item.language || '').toLowerCase();
      if (declared.indexOf('zh') === 0) return 'zh';
      if (declared.indexOf('en') === 0) return 'en';
      var categoryName = String(item.category || '').toLowerCase();
      if (categoryName === 'chinese') return 'zh';
      if (categoryName === 'english') return 'en';
      var categories = item.categories && item.categories.toArray ? item.categories.toArray() : [];
      for (var i = 0; i < categories.length; i++) {
        var name = String(categories[i].name || '').toLowerCase();
        if (name === 'chinese') return 'zh';
        if (name === 'english') return 'en';
      }
      return 'en';
    }
    var currentLang = page.lang_filter || ((page.path || '').indexOf('zh/') === 0 ? 'zh' : languageOf(page));
    var pagePostList = page.posts ? (page.posts.toArray ? page.posts.toArray() : page.posts) : [];
    var visiblePosts = pagePostList.filter(function(post) { return languageOf(post) === currentLang; });
  if page.category || page.tag
    h1.label-title=  __('reading_label', page.category || page.tag)
  .post
    .post-archive
      - var allposts = visiblePosts.reduce((r, v, i, a, k = -v.date.format('YYYY')) => ((r[k] || (r[k] = [])).push(v), r), {})
      each posts, year in allposts
        h2= -year
        ul.listing
          for post in posts
            li
              span.date= post.date.format(config.date_format)
              a(href=url_for(post.path), title=post.title)
                +title(post)
  if !page.lang_filter
    include _partial/paginator.pug
